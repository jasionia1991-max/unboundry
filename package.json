    "test:viewport": "playwright test tests/m1-viewport.spec.ts",
    "test:interaction": "playwright test tests/m1-selection-drag.spec.ts tests/m1-multi-source-connect.spec.ts tests/m1-delete-undo.spec.ts tests/m1-workflow.spec.ts tests/m1-dense-canvas.spec.ts",
    "test:edges": "playwright test tests/m1-minimap-edge.spec.ts tests/m1-source-menu.spec.ts",
