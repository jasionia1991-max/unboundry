    "data:verify-backup": "node scripts/verify-backup.mjs",
    "data:restore-backup": "node scripts/restore-backup.mjs",
    "verify:apparel-auto-launch": "node scripts/verify-ecommerce-apparel-auto-launch.mjs",
    "apply:apparel-auto-launch": "node scripts/apply-ecommerce-apparel-auto-launch.mjs",
    "test:backup": "node scripts/run-safe-tests.mjs run --spec tests/m10-backup.spec.ts",
    "test:backup-rehearsal": "node scripts/run-safe-tests.mjs run --spec tests/m10-backup.spec.ts",
    "test:workflow-integration": "node scripts/run-safe-tests.mjs run --spec tests/m104-inc-gen-026-reliability.spec.ts",
    "test:ci:reliability": "node scripts/run-safe-tests.mjs run --spec tests/m104-inc-gen-026-reliability.spec.ts",
