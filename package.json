    "test:audio": "playwright test tests/m2-audio-node.spec.ts",
    "test:playlist": "playwright test tests/m2-playlist-node.spec.ts",
    "test:group": "playwright test tests/m2-group-node.spec.ts",
    "test:geometry": "playwright test tests/m2-node-geometry.spec.ts",
    "test:storyboard": "playwright test tests/m2-storyboard-node.spec.ts",
    "test:persistence": "playwright test tests/m3-persistence.spec.ts",
    "test:history": "playwright test tests/m3-history.spec.ts",
    "test:restart": "node scripts/run-safe-tests.mjs run --spec tests/m3-persistence.spec.ts",
    "test:revision": "playwright test tests/m3-revision-conflict.spec.ts",
    "test:upload": "playwright test tests/m4-image-upload.spec.ts",
    "test:audio-upload": "playwright test tests/m4-audio-upload.spec.ts",
    "test:video-upload": "playwright test tests/m4-video-upload.spec.ts",
    "test:generation-tasks": "playwright test tests/m5-generation-task-store.spec.ts",
