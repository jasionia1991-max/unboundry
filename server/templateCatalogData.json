 "ecommerce-image-expert-213": {
  "id": "aaf7cc53-a595-45da-a6bb-7c93309e0962",
  "title": "213.电商图片生成专家",
  "description": "上传产品图，一键直出商品主图、详情页、宣传海报、卖点图、场景图、漫画宣传图",
  "previewImage": "/templates/ecommerce-image-expert-213.png",
